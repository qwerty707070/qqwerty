# Пароль администратора (обязательно задайте свой)
ADMIN_PASSWORD=change-me-please

# Секрет для подписи куки сессии, >= 32 символов
ADMIN_SESSION_SECRET=please-generate-a-long-random-string-32

# Необязательно: 2FA. Base32-секрет из приложения-аутентификатора
# ADMIN_TOTP_SECRET=JBSWY3DPEHPK3PXP

# Необязательно: Supabase вместо файла .data/settings.json
# (нужны таблицы из supabase/schema.sql)
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
